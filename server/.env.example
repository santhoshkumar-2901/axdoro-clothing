# AXDORO Server Environment Configuration Template
# Copy this file to .env and customize for your local environment
# NEVER commit .env to source control!

# Environment mode: 'development', 'production', 'test'
NODE_ENV=development

# Server HTTP Port
PORT=5000

# Client Application URL for CORS
CORS_ORIGIN=http://localhost:5173

# --- LOCAL DATABASE SETTINGS ---
# Application Runtime connection (least privilege role)
DATABASE_URL=postgresql://axdoro_app:axdoro_local_app_pw@localhost:5432/axdoro_dev

# Migrator connection (used for DDL migrations and test teardown)
MIGRATION_DATABASE_URL=postgresql://axdoro_migrator:axdoro_local_migrator_pw@localhost:5432/axdoro_dev

# Test database connection
TEST_DATABASE_URL=postgresql://axdoro_migrator:axdoro_local_migrator_pw@localhost:5432/axdoro_test

# --- NEON PRODUCTION DATABASE SETTINGS (Production Hosting Only) ---
# Direct / Pooler connection string retrieved from Neon Console. Must have sslmode=require.
# For migrations, always use the Direct (non-pooler) connection string.
# NEON_DATABASE_URL=postgresql://user:password@ep-xyz-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# --- SECURITY SECRETS ---
# Cryptographic secret for signing admin JWT session cookies (min 32 characters)
JWT_SECRET=change_this_to_a_secure_random_32_character_secret_for_local_dev
