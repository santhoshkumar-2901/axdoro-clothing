# AXDORO Server Environment Configuration Template
# Copy this file to .env and customize for your local environment
# NEVER commit .env to source control!

# Environment mode: 'development', 'production', 'test'
NODE_ENV=development

# Server HTTP Port
PORT=5000

# Client Application URL for CORS
CORS_ORIGIN=http://localhost:5173

# --- LOCAL DATABASE SETTINGS (Default) ---
# Application Runtime connection (least privilege role)
DATABASE_URL=postgresql://axdoro_app:axdoro_local_app_pw@localhost:5432/axdoro_dev

# Migrator connection (used for DDL migrations and test teardown)
MIGRATION_DATABASE_URL=postgresql://axdoro_migrator:axdoro_local_migrator_pw@localhost:5432/axdoro_dev

# Test database connection (strictly local, dedicated test database)
TEST_DATABASE_URL=postgresql://axdoro_migrator:axdoro_local_migrator_pw@localhost:5432/axdoro_test

# --- REMOTE NEON DEVELOPMENT OPT-IN (Phase 8.1) ---
# Safe default is 'false'. Set to 'true' only when explicitly connecting to an authorized Neon dev branch.
# Test suite (NODE_ENV=test) will ALWAYS reject remote databases regardless of this flag.
ALLOW_REMOTE_DEV_DB=false

# When ALLOW_REMOTE_DEV_DB=true is enabled for remote development:
# 1. DATABASE_URL should use the Neon Pooled endpoint (with -pooler suffix) for runtime queries:
#    DATABASE_URL=postgresql://user:password@ep-xyz-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
# 2. MIGRATION_DATABASE_URL MUST use the Neon Direct endpoint (without -pooler) for DDL & advisory locks:
#    MIGRATION_DATABASE_URL=postgresql://user:password@ep-xyz.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# --- NEON PRODUCTION DATABASE SETTINGS (Production Hosting Only) ---
# NEON_DATABASE_URL=postgresql://user:password@ep-xyz-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# --- SECURITY SECRETS ---
# Cryptographic secret for signing admin JWT session cookies (min 32 characters)
JWT_SECRET=change_this_to_a_secure_random_32_character_secret_for_local_dev

# --- CLOUDINARY PRODUCT IMAGE MANAGEMENT ---
# Credentials for secure image upload signing and asset deletion (Server-side only)
# Leave unset in local development if live Cloudinary integration is not active
# CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
# CLOUDINARY_API_KEY=your_cloudinary_api_key
# CLOUDINARY_API_SECRET=your_cloudinary_api_secret
